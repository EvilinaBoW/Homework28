            #region 2.3: Паттерн Strategy с динамическим выбором алгоритма
            static void TestStrategyPattern()
            {
                var sorter = new DynamicSorter();

                var smallData = Enumerable.Range(1, 100).Select(x => Guid.NewGuid()).ToArray();
                var largeData = Enumerable.Range(1, 10000).Select(x => Guid.NewGuid()).ToArray();

                sorter.Sort(smallData); // Выберет QuickSort
                sorter.Sort(largeData); // Выберет MergeSort
            }

            public interface ISortStrategy<T>
            {
                void Sort(T[] array);
                TimeSpan LastExecutionTime { get; }
            }

            public class QuickSortStrategy<T> : ISortStrategy<T> where T : IComparable<T>
            {
                public TimeSpan LastExecutionTime { get; private set; }

                public void Sort(T[] array)
                {
                    var stopwatch = Stopwatch.StartNew();
                    Array.Sort(array);
                    stopwatch.Stop();
                    LastExecutionTime = stopwatch.Elapsed;
                }
            }

            public class MergeSortStrategy<T> : ISortStrategy<T> where T : IComparable<T>
            {
                public TimeSpan LastExecutionTime { get; private set; }

                public void Sort(T[] array)
                {
                    var stopwatch = Stopwatch.StartNew();
                    MergeSort(array, 0, array.Length - 1);
                    stopwatch.Stop();
                    LastExecutionTime = stopwatch.Elapsed;
                }

                private void MergeSort(T[] array, int left, int right)
                {
                    if (left < right)
                    {
                        int mid = (left + right) / 2;
                        MergeSort(array, left, mid);
                        MergeSort(array, mid + 1, right);
                        Merge(array, left, mid, right);
                    }
                }

                private void Merge(T[] array, int left, int mid, int right)
                {
                    // Реализация слияния
                }
            }

            public class DynamicSorter<T> where T : IComparable<T>
            {
                private readonly Dictionary<string, ISortStrategy<T>> _strategies =
                    new Dictionary<string, ISortStrategy<T>>();
                private ISortStrategy<T> _currentStrategy;

                public DynamicSorter()
                {
                    _strategies["quick"] = new QuickSortStrategy<T>();
                    _strategies["merge"] = new MergeSortStrategy<T>();
                    _currentStrategy = _strategies["quick"];
                }

                public void Sort(T[] array)
                {
                    // Динамический выбор стратегии на основе размера данных
                    _currentStrategy = array.Length < 1000 ?
                        _strategies["quick"] : _strategies["merge"];

                    _currentStrategy.Sort(array);
                    Console.WriteLine($"Used strategy for {array.Length} elements: {_currentStrategy.GetType().Name}");
                }
            }
