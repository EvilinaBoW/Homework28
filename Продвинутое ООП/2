            public class GenericFactory<T> where T : IProduct, new()
            {
                private static readonly ConcurrentDictionary<Type, Func<object>> _constructors =
                    new ConcurrentDictionary<Type, Func<object>>();

                public T Create()
                {
                    var type = typeof(T);
                    var constructor = _constructors.GetOrAdd(type, t =>
                        Expression.Lambda<Func<object>>(Expression.New(t)).Compile());

                    return (T)constructor();
                }
            }

            public class DynamicFactory
            {
                private readonly Dictionary<string, Type> _registeredTypes = new Dictionary<string, Type>();

                public void RegisterType<T>(string key) where T : IProduct
                {
                    _registeredTypes[key] = typeof(T);
                }

                public IProduct Create(string key)
                {
                    if (_registeredTypes.TryGetValue(key, out var type))
                    {
                        return (IProduct)Activator.CreateInstance(type);
                    }
                    throw new ArgumentException($"Type with key '{key}' not registered");
                }
            }
