            #region 2.8: Паттерн Command для отмены/повтора операций
            public interface ICommand
            {
                void Execute();
                void Undo();
            }

            public class TextEditor
            {
                private string _text = "";
                private readonly Stack<ICommand> _undoStack = new Stack<ICommand>();
                private readonly Stack<ICommand> _redoStack = new Stack<ICommand>();

                public void ExecuteCommand(ICommand command)
                {
                    command.Execute();
                    _undoStack.Push(command);
                    _redoStack.Clear();
                }

                public void Undo()
                {
                    if (_undoStack.Count > 0)
                    {
                        var command = _undoStack.Pop();
                        command.Undo();
                        _redoStack.Push(command);
                    }
                }

                public void Redo()
                {
                    if (_redoStack.Count > 0)
                    {
                        var command = _redoStack.Pop();
                        command.Execute();
                        _undoStack.Push(command);
                    }
                }

                public string Text
                {
                    get => _text;
                    set => _text = value;
                }
            }

            public class AddTextCommand : ICommand
            {
                private readonly TextEditor _editor;
                private readonly string _textToAdd;
                private string _previousText;

                public AddTextCommand(TextEditor editor, string text)
                {
                    _editor = editor;
                    _textToAdd = text;
                }

                public void Execute()
                {
                    _previousText = _editor.Text;
                    _editor.Text += _textToAdd;
                }

                public void Undo()
                {
                    _editor.Text = _previousText;
                }
            }
            #endregion

