            #region 2.1: Паттерн Observer с обработкой исключений
            static void TestObserverPattern()
            {
                var publisher = new EventPublisher();
                var subscriber1 = new AdvancedSubscriber("Sub1");
                var subscriber2 = new AdvancedSubscriber("Sub2");

                publisher.Subscribe("event.type1", subscriber1);
                publisher.Subscribe("event.type2", subscriber2);

                publisher.Publish("event.type1", new EventData { Message = "Test Message" });
            }

            public class EventData
            {
                public string Message { get; set; }
                public DateTime Timestamp { get; set; } = DateTime.Now;
            }

            public interface ISubscriber
            {
                string Name { get; }
                Task HandleEventAsync(string eventType, EventData data);
                SubscriberMetrics GetMetrics();
            }

            public class SubscriberMetrics
            {
                public int TotalEventsProcessed { get; set; }
                public int FailedEvents { get; set; }
                public double AverageProcessingTimeMs { get; set; }
                public DateTime LastActivity { get; set; }
            }

            public class AdvancedSubscriber : ISubscriber
            {
                private readonly SubscriberMetrics _metrics = new SubscriberMetrics();
                private readonly Random _random = new Random();

                public string Name { get; }

                public AdvancedSubscriber(string name) => Name = name;

                public async Task HandleEventAsync(string eventType, EventData data)
                {
                    var stopwatch = Stopwatch.StartNew();

                    try
                    {
                        // Имитация обработки с случайной задержкой
                        await Task.Delay(_random.Next(50, 200));

                        // Имитация случайных ошибок
                        if (_random.Next(0, 10) == 0)
                            throw new InvalidOperationException("Simulated processing error");

                        Interlocked.Increment(ref _metrics.TotalEventsProcessed);
                        Console.WriteLine($"{Name} processed event: {eventType} - {data.Message}");
                    }
                    catch (Exception ex)
                    {
                        Interlocked.Increment(ref _metrics.FailedEvents);
                        Console.WriteLine($"{Name} failed to process event: {ex.Message}");
                        throw;
                    }
                    finally
                    {
                        stopwatch.Stop();
                        _metrics.AverageProcessingTimeMs = (_metrics.AverageProcessingTimeMs + stopwatch.ElapsedMilliseconds) / 2;
                        _metrics.LastActivity = DateTime.Now;
                    }
                }

                public SubscriberMetrics GetMetrics() => _metrics;
            }

            public class EventPublisher
            {
                private readonly ConcurrentDictionary<string, List<ISubscriber>> _subscriptions =
                    new ConcurrentDictionary<string, List<ISubscriber>>();
                private readonly ConcurrentQueue<(string, EventData)> _deadLetterQueue =
                    new ConcurrentQueue<(string, EventData)>();
                private readonly object _lockObject = new object();

                public void Subscribe(string eventType, ISubscriber subscriber)
                {
                    var subscribers = _subscriptions.GetOrAdd(eventType, _ => new List<ISubscriber>());
                    lock (subscribers)
                    {
                        if (!subscribers.Contains(subscriber))
                            subscribers.Add(subscriber);
                    }
                }

                public void Unsubscribe(string eventType, ISubscriber subscriber)
                {
                    if (_subscriptions.TryGetValue(eventType, out var subscribers))
                    {
                        lock (subscribers)
                        {
                            subscribers.Remove(subscriber);
                        }
                    }
                }

                public async void Publish(string eventType, EventData data)
                {
                    if (_subscriptions.TryGetValue(eventType, out var subscribers))
                    {
                        var tasks = new List<Task>();

                        foreach (var subscriber in subscribers.ToArray())
                        {
                            tasks.Add(Task.Run(async () =>
                            {
                                try
                                {
                                    await subscriber.HandleEventAsync(eventType, data);
                                }
                                catch
                                {
                                    // Помещаем в очередь мертвых писем при ошибке
                                    _deadLetterQueue.Enqueue((eventType, data));
                                }
                            }));
                        }

                        await Task.WhenAll(tasks);
                    }
                }
            }
            #endregion

            #region 2.2: Паттерн Decorator для добавления функциональности
            static void TestDecoratorPattern()
            {
                ICalculator calculator = new BasicCalculator();
                calculator = new LoggingDecorator(calculator);
                calculator = new CachingDecorator(calculator);
                calculator = new ValidationDecorator(calculator);
                calculator = new PerformanceDecorator(calculator);

                var result = calculator.Add(5, 3);
                Console.WriteLine($"Decorator Result: {result}");
            }

            public interface ICalculator
            {
                int Add(int a, int b);
                int Multiply(int a, int b);
            }

            public class BasicCalculator : ICalculator
            {
                public int Add(int a, int b) => a + b;
                public int Multiply(int a, int b) => a * b;
            }

            public abstract class CalculatorDecorator : ICalculator
            {
                protected ICalculator _calculator;

                protected CalculatorDecorator(ICalculator calculator)
                {
                    _calculator = calculator;
                }

                public virtual int Add(int a, int b) => _calculator.Add(a, b);
                public virtual int Multiply(int a, int b) => _calculator.Multiply(a, b);
            }

            public class LoggingDecorator : CalculatorDecorator
            {
                public LoggingDecorator(ICalculator calculator) : base(calculator) { }

                public override int Add(int a, int b)
                {
                    Console.WriteLine($"Adding {a} and {b}");
                    var result = base.Add(a, b);
                    Console.WriteLine($"Result: {result}");
                    return result;
                }
            }

            public class CachingDecorator : CalculatorDecorator
            {
                private readonly Dictionary<string, int> _cache = new Dictionary<string, int>();

                public CachingDecorator(ICalculator calculator) : base(calculator) { }

                public override int Add(int a, int b)
                {
                    var key = $"Add_{a}_{b}";
                    if (_cache.ContainsKey(key))
                        return _cache[key];

                    var result = base.Add(a, b);
                    _cache[key] = result;
                    return result;
                }
            }

            public class ValidationDecorator : CalculatorDecorator
            {
                public ValidationDecorator(ICalculator calculator) : base(calculator) { }

                public override int Add(int a, int b)
                {
                    if (a < 0 || b < 0)
                        throw new ArgumentException("Values must be non-negative");

                    return base.Add(a, b);
                }
            }

            public class PerformanceDecorator : CalculatorDecorator
            {
                public PerformanceDecorator(ICalculator calculator) : base(calculator) { }

                public override int Add(int a, int b)
                {
                    var stopwatch = Stopwatch.StartNew();
                    var result = base.Add(a, b);
                    stopwatch.Stop();
                    Console.WriteLine($"Add operation took: {stopwatch.ElapsedMilliseconds}ms");
                    return result;
                }
            }
