            #region 2.5: Паттерн Builder с fluent interface
            public class Computer
            {
                public string CPU { get; }
                public string RAM { get; }
                public string Storage { get; }
                public string GPU { get; }

                private Computer(string cpu, string ram, string storage, string gpu)
                {
                    CPU = cpu;
                    RAM = ram;
                    Storage = storage;
                    GPU = gpu;
                }

                public class Builder
                {
                    private string _cpu;
                    private string _ram;
                    private string _storage;
                    private string _gpu;

                    public Builder SetCPU(string cpu)
                    {
                        if (string.IsNullOrEmpty(cpu))
                            throw new ArgumentException("CPU cannot be null or empty");
                        _cpu = cpu;
                        return this;
                    }

                    public Builder SetRAM(string ram)
                    {
                        if (string.IsNullOrEmpty(ram))
                            throw new ArgumentException("RAM cannot be null or empty");
                        _ram = ram;
                        return this;
                    }

                    public Builder SetStorage(string storage)
                    {
                        _storage = storage;
                        return this;
                    }

                    public Builder SetGPU(string gpu)
                    {
                        _gpu = gpu;
                        return this;
                    }

                    public Computer Build()
                    {
                        if (string.IsNullOrEmpty(_cpu) || string.IsNullOrEmpty(_ram))
                            throw new InvalidOperationException("CPU and RAM are required");

                        return new Computer(_cpu, _ram, _storage, _gpu);
                    }
                }
            }
