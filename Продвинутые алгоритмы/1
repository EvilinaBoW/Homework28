        #region 1.1 Задача о рюкзаке
        public static class Knapsack01
        {
            public static (int maxValue, List<int> selectedItems) Solve(int[] weights, int[] values, int capacity)
            {
                int n = weights.Length;
                int[,] dp = new int[n + 1, capacity + 1];

                for (int i = 1; i <= n; i++)
                {
                    for (int w = 0; w <= capacity; w++)
                    {
                        if (weights[i - 1] <= w)
                        {
                            dp[i, w] = Math.Max(
                                dp[i - 1, w],
                                dp[i - 1, w - weights[i - 1]] + values[i - 1]
                            );
                        }
                        else
                        {
                            dp[i, w] = dp[i - 1, w];
                        }
                    }
                }

                List<int> selectedItems = new List<int>();
                int remainingCapacity = capacity;
                for (int i = n; i > 0; i--)
                {
                    if (dp[i, remainingCapacity] != dp[i - 1, remainingCapacity])
                    {
                        selectedItems.Add(i - 1);
                        remainingCapacity -= weights[i - 1];
                    }
                }

                selectedItems.Reverse();
                return (dp[n, capacity], selectedItems);
            }

            public static int BoundedKnapsack(int[] weights, int[] values, int[] counts, int capacity)
            {
                int n = weights.Length;
                int[] dp = new int[capacity + 1];

                for (int i = 0; i < n; i++)
                {
                    for (int j = capacity; j >= weights[i]; j--)
                    {
                        for (int k = 1; k <= counts[i] && k * weights[i] <= j; k++)
                        {
                            dp[j] = Math.Max(dp[j], dp[j - k * weights[i]] + k * values[i]);
                        }
                    }
                }

                return dp[capacity];
            }

            public static int UnboundedKnapsack(int[] weights, int[] values, int capacity)
            {
                int[] dp = new int[capacity + 1];

                for (int w = 0; w <= capacity; w++)
                {
                    for (int i = 0; i < weights.Length; i++)
                    {
                        if (weights[i] <= w)
                        {
                            dp[w] = Math.Max(dp[w], dp[w - weights[i]] + values[i]);
                        }
                    }
                }

                return dp[capacity];
            }
        }
        #endregion

        #region 1.2 Дерево сегментов с ленивым распространением
        public class SegmentTree
        {
            private int[] tree;
            private int[] lazy;
            private int[] original;
            private int n;
            private Operation operation;

            public enum Operation { Sum, Min, Max }

            public SegmentTree(int[] arr, Operation op)
            {
                n = arr.Length;
                original = arr;
                operation = op;
                tree = new int[4 * n];
                lazy = new int[4 * n];
                Build(1, 0, n - 1);
            }

            private void Build(int node, int start, int end)
            {
                if (start == end)
                {
                    tree[node] = original[start];
                }
                else
                {
                    int mid = (start + end) / 2;
                    Build(2 * node, start, mid);
                    Build(2 * node + 1, mid + 1, end);
                    tree[node] = Combine(tree[2 * node], tree[2 * node + 1]);
                }
            }

            private int Combine(int a, int b)
            {
                return operation switch
                {
                    Operation.Sum => a + b,
                    Operation.Min => Math.Min(a, b),
                    Operation.Max => Math.Max(a, b),
                    _ => a + b
                };
            }

            public void UpdateRange(int l, int r, int value)
            {
                UpdateRange(1, 0, n - 1, l, r, value);
            }

            private void UpdateRange(int node, int start, int end, int l, int r, int value)
            {
                if (lazy[node] != 0)
                {
                    tree[node] += (end - start + 1) * lazy[node];
                    if (start != end)
                    {
                        lazy[2 * node] += lazy[node];
                        lazy[2 * node + 1] += lazy[node];
                    }
                    lazy[node] = 0;
                }

                if (start > end || start > r || end < l) return;

                if (start >= l && end <= r)
                {
                    tree[node] += (end - start + 1) * value;
                    if (start != end)
                    {
                        lazy[2 * node] += value;
                        lazy[2 * node + 1] += value;
                    }
                    return;
                }

                int mid = (start + end) / 2;
                UpdateRange(2 * node, start, mid, l, r, value);
                UpdateRange(2 * node + 1, mid + 1, end, l, r, value);
                tree[node] = Combine(tree[2 * node], tree[2 * node + 1]);
            }

            public int QueryRange(int l, int r)
            {
                return QueryRange(1, 0, n - 1, l, r);
            }

            private int QueryRange(int node, int start, int end, int l, int r)
            {
                if (start > end || start > r || end < l)
                    return operation == Operation.Min ? int.MaxValue : 0;

                if (lazy[node] != 0)
                {
                    tree[node] += (end - start + 1) * lazy[node];
                    if (start != end)
                    {
                        lazy[2 * node] += lazy[node];
                        lazy[2 * node + 1] += lazy[node];
                    }
                    lazy[node] = 0;
                }

                if (start >= l && end <= r)
                    return tree[node];

                int mid = (start + end) / 2;
                int left = QueryRange(2 * node, start, mid, l, r);
                int right = QueryRange(2 * node + 1, mid + 1, end, l, r);
                return Combine(left, right);
            }
        }
        #endregion

        #region 1.3 Алгоритм Дейкстры
        public class Dijkstra
        {
            public static (int[] distances, List<List<int>> paths) FindShortestPaths(
                List<List<(int to, int weight)>> graph, int start)
            {
                int n = graph.Count;
                int[] dist = new int[n];
                List<HashSet<int>> prev = new List<HashSet<int>>();
                List<List<int>> allPaths = new List<List<int>>();

                for (int i = 0; i < n; i++)
                {
                    dist[i] = int.MaxValue;
                    prev.Add(new HashSet<int>());
                    allPaths.Add(new List<int>());
                }

                dist[start] = 0;

                var pq = new PriorityQueue<(int node, int distance), int>();
                pq.Enqueue((start, 0), 0);

                while (pq.Count > 0)
                {
                    var (current, currentDist) = pq.Dequeue();

                    if (currentDist > dist[current]) continue;

                    foreach (var (neighbor, weight) in graph[current])
                    {
                        int newDist = currentDist + weight;

                        if (newDist < dist[neighbor])
                        {
                            dist[neighbor] = newDist;
                            prev[neighbor].Clear();
                            prev[neighbor].Add(current);
                            pq.Enqueue((neighbor, newDist), newDist);
                        }
                        else if (newDist == dist[neighbor])
                        {
                            prev[neighbor].Add(current);
                        }
                    }
                }

                for (int i = 0; i < n; i++)
                {
                    if (dist[i] != int.MaxValue)
                    {
                        ReconstructPaths(i, start, prev, new List<int>(), allPaths);
                    }
                }

                return (dist, allPaths);
            }

            private static void ReconstructPaths(int current, int start, List<HashSet<int>> prev,
                List<int> currentPath, List<List<int>> allPaths)
            {
                currentPath.Add(current);

                if (current == start)
                {
                    currentPath.Reverse();
                    allPaths[current].AddRange(currentPath);
                    currentPath.Reverse();
                }
                else
                {
                    foreach (int p in prev[current])
                    {
                        ReconstructPaths(p, start, prev, currentPath, allPaths);
                    }
                }

                currentPath.RemoveAt(currentPath.Count - 1);
            }
        }

        public class PriorityQueue<TElement, TPriority> where TPriority : IComparable<TPriority>
        {
            private List<(TElement element, TPriority priority)> elements = new List<(TElement, TPriority)>();

            public int Count => elements.Count;

            public void Enqueue(TElement element, TPriority priority)
            {
                elements.Add((element, priority));
                int child = elements.Count - 1;
                while (child > 0)
                {
                    int parent = (child - 1) / 2;
                    if (elements[child].priority.CompareTo(elements[parent].priority) >= 0)
                        break;
                    Swap(child, parent);
                    child = parent;
                }
            }

            public TElement Dequeue()
            {
                var result = elements[0].element;
                elements[0] = elements[elements.Count - 1];
                elements.RemoveAt(elements.Count - 1);

                int parent = 0;
                while (true)
                {
                    int left = 2 * parent + 1;
                    int right = 2 * parent + 2;
                    if (left >= elements.Count) break;

                    int minChild = (right < elements.Count &&
                        elements[right].priority.CompareTo(elements[left].priority) < 0) ? right : left;

                    if (elements[parent].priority.CompareTo(elements[minChild].priority) <= 0)
                        break;

                    Swap(parent, minChild);
                    parent = minChild;
                }

                return result;
            }

            public TElement Peek() => elements[0].element;

            private void Swap(int i, int j)
            {
                var temp = elements[i];
                elements[i] = elements[j];
                elements[j] = temp;
            }
        }
        #endregion

        #region 1.4 Суффиксное дерево
        public class SuffixTree
        {
            private class Node
            {
                public Dictionary<char, Node> Children = new Dictionary<char, Node>();
                public int Start;
                public int? End;
                public Node SuffixLink;
                public bool IsLeaf => Children.Count == 0;
            }

            private Node root = new Node();
            private string text;
            private Node activeNode;
            private int activeEdge = -1;
            private int activeLength = 0;
            private int remainingSuffixCount = 0;
            private int leafEnd = -1;

            public SuffixTree(string text)
            {
                this.text = text + "$";
                BuildTree();
            }

            private void BuildTree()
            {
                activeNode = root;
                for (int i = 0; i < text.Length; i++)
                {
                    ExtendTree(i);
                }
            }

            private void ExtendTree(int pos)
            {
                leafEnd = pos;
                remainingSuffixCount++;
                Node lastNewNode = null;

                while (remainingSuffixCount > 0)
                {
                    if (activeLength == 0)
                        activeEdge = pos;

                    if (!activeNode.Children.ContainsKey(text[activeEdge]))
                    {
                        activeNode.Children[text[activeEdge]] = new Node { Start = pos, End = null };
                        if (lastNewNode != null)
                        {
                            lastNewNode.SuffixLink = activeNode;
                            lastNewNode = null;
                        }
                    }
                    else
                    {
                        break;
                    }

                    remainingSuffixCount--;
                    if (activeNode != root)
                        activeNode = activeNode.SuffixLink ?? root;
                }
            }

            public List<int> SearchPattern(string pattern)
            {
                List<int> positions = new List<int>();
                Node current = root;
                int patternIndex = 0;

                while (patternIndex < pattern.Length)
                {
                    if (!current.Children.ContainsKey(pattern[patternIndex]))
                        return positions;

                    current = current.Children[pattern[patternIndex]];
                    int edgeLength = (current.End ?? leafEnd) - current.Start + 1;

                    for (int i = 0; i < edgeLength && patternIndex < pattern.Length; i++, patternIndex++)
                    {
                        if (text[current.Start + i] != pattern[patternIndex])
                            return positions;
                    }
                }

                CollectPositions(current, positions);
                return positions;
            }

            private void CollectPositions(Node node, List<int> positions)
            {
                if (node.IsLeaf)
                {
                    positions.Add(text.Length - (leafEnd - node.Start + 1));
                }
                else
                {
                    foreach (var child in node.Children.Values)
                    {
                        CollectPositions(child, positions);
                    }
                }
            }

            public string FindLongestRepeatedSubstring()
            {
                string result = "";
                FindLRS(root, "", ref result);
                return result;
            }

            private void FindLRS(Node node, string current, ref string longest)
            {
                if (node.Children.Count > 1 && current.Length > longest.Length)
                {
                    longest = current;
                }

                foreach (var child in node.Children.Values)
                {
                    string edge = text.Substring(child.Start, (child.End ?? leafEnd) - child.Start + 1);
                    FindLRS(child, current + edge, ref longest);
                }
            }

            public string FindLongestCommonSubstring(string other)
            {
                // Упрощенная реализация для демонстрации
                string longest = "";
                for (int i = 0; i < other.Length; i++)
                {
                    for (int j = i + 1; j <= other.Length; j++)
                    {
                        string substring = other.Substring(i, j - i);
                        if (SearchPattern(substring).Count > 0 && substring.Length > longest.Length)
                        {
                            longest = substring;
                        }
                    }
                }
                return longest;
            }
        }
        #endregion

        #region 1.5 Union-Find
        public class UnionFind
        {
            private int[] parent;
            private int[] rank;
            private int[] size;
            private int components;
            private Stack<(int, int, int, int)> history;

            public UnionFind(int n, bool supportUndo = false)
            {
                parent = new int[n];
                rank = new int[n];
                size = new int[n];
                components = n;

                if (supportUndo)
                    history = new Stack<(int, int, int, int)>();

                for (int i = 0; i < n; i++)
                {
                    parent[i] = i;
                    rank[i] = 0;
                    size[i] = 1;
                }
            }

            public int Find(int x)
            {
                if (parent[x] != x)
                    parent[x] = Find(parent[x]);
                return parent[x];
            }

            public bool Union(int x, int y)
            {
                int rootX = Find(x);
                int rootY = Find(y);

                if (rootX == rootY) return false;

                if (history != null)
                    history.Push((rootX, rootY, rank[rootX], components));

                if (rank[rootX] < rank[rootY])
                {
                    parent[rootX] = rootY;
                    size[rootY] += size[rootX];
                }
                else if (rank[rootX] > rank[rootY])
                {
                    parent[rootY] = rootX;
                    size[rootX] += size[rootY];
                }
                else
                {
                    parent[rootY] = rootX;
                    rank[rootX]++;
                    size[rootX] += size[rootY];
                }

                components--;
                return true;
            }

            public void Undo()
            {
                if (history == null || history.Count == 0)
                    throw new InvalidOperationException("No operations to undo");

                var (rootX, rootY, oldRank, oldComponents) = history.Pop();
                parent[rootX] = rootX;
                parent[rootY] = rootY;
                rank[rootX] = oldRank;
                components = oldComponents;
            }

            public bool Connected(int x, int y) => Find(x) == Find(y);
            public int ComponentSize(int x) => size[Find(x)];
            public int ComponentsCount => components;
        }
