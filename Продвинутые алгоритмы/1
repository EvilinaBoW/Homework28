        #region 1.13 Алгоритм Косарайю
        public static class Kosaraju
        {
            public static List<List<int>> FindSCC(int n, List<List<int>> graph)
            {
                // Первый проход DFS для порядка завершения
                bool[] visited = new bool[n];
                Stack<int> stack = new Stack<int>();

                for (int i = 0; i < n; i++)
                {
                    if (!visited[i])
                        FirstDFS(i, graph, visited, stack);
                }

                // Транспонирование графа
                var transposed = TransposeGraph(n, graph);

                // Второй проход DFS в порядке стека
                ArrayFill(visited, false);
                List<List<int>> scc = new List<List<int>>();

                while (stack.Count > 0)
                {
                    int node = stack.Pop();
                    if (!visited[node])
                    {
                        List<int> component = new List<int>();
                        SecondDFS(node, transposed, visited, component);
                        scc.Add(component);
                    }
                }

                return scc;
            }

            private static void ArrayFill(bool[] array, bool value)
            {
                for (int i = 0; i < array.Length; i++)
                {
                    array[i] = value;
                }
            }

            private static void FirstDFS(int u, List<List<int>> graph, bool[] visited, Stack<int> stack)
            {
                visited[u] = true;
                foreach (int v in graph[u])
                {
                    if (!visited[v])
                        FirstDFS(v, graph, visited, stack);
                }
                stack.Push(u);
            }

            private static List<List<int>> TransposeGraph(int n, List<List<int>> graph)
            {
                var transposed = new List<List<int>>();
                for (int i = 0; i < n; i++)
                    transposed.Add(new List<int>());

                for (int u = 0; u < n; u++)
                {
                    foreach (int v in graph[u])
                    {
                        transposed[v].Add(u);
                    }
                }

                return transposed;
            }

            private static void SecondDFS(int u, List<List<int>> graph, bool[] visited, List<int> component)
            {
                visited[u] = true;
                component.Add(u);
                foreach (int v in graph[u])
                {
                    if (!visited[v])
                        SecondDFS(v, graph, visited, component);
                }
            }
        }
        #endregion

        #region 1.14 TSP
        public static class TSP
        {
            public static (int cost, List<int> path) Solve(int[,] graph)
            {
                int n = graph.GetLength(0);
                int[,] dp = new int[1 << n, n];
                int[,] parent = new int[1 << n, n];

                for (int i = 0; i < (1 << n); i++)
                    for (int j = 0; j < n; j++)
                        dp[i, j] = int.MaxValue;

                dp[1, 0] = 0;

                for (int mask = 1; mask < (1 << n); mask++)
                {
                    for (int u = 0; u < n; u++)
                    {
                        if (dp[mask, u] == int.MaxValue) continue;

                        for (int v = 0; v < n; v++)
                        {
                            if ((mask & (1 << v)) == 0 && graph[u, v] > 0)
                            {
                                int newMask = mask | (1 << v);
                                int newCost = dp[mask, u] + graph[u, v];
                                if (newCost < dp[newMask, v])
                                {
                                    dp[newMask, v] = newCost;
                                    parent[newMask, v] = u;
                                }
                            }
                        }
                    }
                }

                // Восстановление пути
                int finalMask = (1 << n) - 1;
                int minCost = int.MaxValue;
                int last = -1;

                for (int i = 0; i < n; i++)
                {
                    if (dp[finalMask, i] != int.MaxValue && graph[i, 0] > 0)
                    {
                        int cost = dp[finalMask, i] + graph[i, 0];
                        if (cost < minCost)
                        {
                            minCost = cost;
                            last = i;
                        }
                    }
                }

                List<int> path = new List<int>();
                int current = last;
                int currentMask = finalMask;

                while (currentMask != 0)
                {
                    path.Add(current);
                    int prev = parent[currentMask, current];
                    currentMask ^= (1 << current);
                    current = prev;
                }
                path.Add(0);
                path.Reverse();

                return (minCost, path);
            }
        }
        #endregion

        #region 1.15 Bellman-Ford
        public static class BellmanFord
        {
            public struct Edge
            {
                public int from;
                public int to;
                public int weight;

                public Edge(int from, int to, int weight)
                {
                    this.from = from;
                    this.to = to;
                    this.weight = weight;
                }
            }

            public static (int[] distances, bool negativeCycle) FindShortestPaths(int n, List<Edge> edges, int source)
            {
                int[] dist = new int[n];
                ArrayFill(dist, int.MaxValue);
                dist[source] = 0;

                for (int i = 0; i < n - 1; i++)
                {
                    foreach (var edge in edges)
                    {
                        if (dist[edge.from] != int.MaxValue && dist[edge.from] + edge.weight < dist[edge.to])
                        {
                            dist[edge.to] = dist[edge.from] + edge.weight;
                        }
                    }
                }

                // Проверка на отрицательные циклы
                bool negativeCycle = false;
                foreach (var edge in edges)
                {
                    if (dist[edge.from] != int.MaxValue && dist[edge.from] + edge.weight < dist[edge.to])
                    {
                        negativeCycle = true;
                        break;
                    }
                }

                return (dist, negativeCycle);
            }

            private static void ArrayFill(int[] array, int value)
            {
                for (int i = 0; i < array.Length; i++)
                {
                    array[i] = value;
                }
            }
        }
