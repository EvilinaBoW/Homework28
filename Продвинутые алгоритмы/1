        #region 1.6 B-дерево
        public class BTree
        {
            private class BTreeNode
            {
                public int[] keys;
                public int t;
                public BTreeNode[] children;
                public int n;
                public bool leaf;

                public BTreeNode(int t, bool leaf)
                {
                    this.t = t;
                    this.leaf = leaf;
                    keys = new int[2 * t - 1];
                    children = new BTreeNode[2 * t];
                    n = 0;
                }

                public void Traverse()
                {
                    int i;
                    for (i = 0; i < n; i++)
                    {
                        if (!leaf)
                            children[i].Traverse();
                        Console.Write(keys[i] + " ");
                    }

                    if (!leaf)
                        children[i].Traverse();
                }

                public bool Search(int k)
                {
                    int i = 0;
                    while (i < n && k > keys[i])
                        i++;

                    if (i < n && keys[i] == k)
                        return true;

                    if (leaf)
                        return false;

                    return children[i].Search(k);
                }
            }

            private BTreeNode root;
            private int t;

            public BTree(int t)
            {
                this.t = t;
                root = null;
            }

            public void Traverse()
            {
                if (root != null)
                    root.Traverse();
            }

            public bool Search(int k)
            {
                return root?.Search(k) ?? false;
            }

            public void Insert(int k)
            {
                if (root == null)
                {
                    root = new BTreeNode(t, true);
                    root.keys[0] = k;
                    root.n = 1;
                }
                else
                {
                    if (root.n == 2 * t - 1)
                    {
                        BTreeNode s = new BTreeNode(t, false);
                        s.children[0] = root;
                        SplitChild(s, 0, root);
                        int i = 0;
                        if (s.keys[0] < k)
                            i++;
                        InsertNonFull(s.children[i], k);
                        root = s;
                    }
                    else
                    {
                        InsertNonFull(root, k);
                    }
                }
            }

            private void InsertNonFull(BTreeNode node, int k)
            {
                int i = node.n - 1;

                if (node.leaf)
                {
                    while (i >= 0 && node.keys[i] > k)
                    {
                        node.keys[i + 1] = node.keys[i];
                        i--;
                    }
                    node.keys[i + 1] = k;
                    node.n++;
                }
                else
                {
                    while (i >= 0 && node.keys[i] > k)
                        i--;

                    i++;
                    if (node.children[i].n == 2 * t - 1)
                    {
                        SplitChild(node, i, node.children[i]);
                        if (node.keys[i] < k)
                            i++;
                    }
                    InsertNonFull(node.children[i], k);
                }
            }

            private void SplitChild(BTreeNode parent, int i, BTreeNode child)
            {
                BTreeNode newChild = new BTreeNode(child.t, child.leaf);
                newChild.n = t - 1;

                for (int j = 0; j < t - 1; j++)
                    newChild.keys[j] = child.keys[j + t];

                if (!child.leaf)
                {
                    for (int j = 0; j < t; j++)
                        newChild.children[j] = child.children[j + t];
                }

                child.n = t - 1;

                for (int j = parent.n; j >= i + 1; j--)
                    parent.children[j + 1] = parent.children[j];

                parent.children[i + 1] = newChild;

                for (int j = parent.n - 1; j >= i; j--)
                    parent.keys[j + 1] = parent.keys[j];

                parent.keys[i] = child.keys[t - 1];
                parent.n++;
            }
        }
        #endregion

        #region 1.7 Fibonacci Heap
        public class FibonacciHeap<T> where T : IComparable<T>
        {
            private class Node
            {
                public T Key;
                public int Degree;
                public bool Marked;
                public Node Parent;
                public Node Child;
                public Node Left;
                public Node Right;

                public Node(T key)
                {
                    Key = key;
                    Degree = 0;
                    Marked = false;
                    Left = this;
                    Right = this;
                }
            }

            private Node minNode;
            private int count;

            public FibonacciHeap()
            {
                minNode = null;
                count = 0;
            }

            public void Insert(T key)
            {
                var node = new Node(key);
                if (minNode == null)
                {
                    minNode = node;
                }
                else
                {
                    AddToRootList(node);
                    if (node.Key.CompareTo(minNode.Key) < 0)
                        minNode = node;
                }
                count++;
            }

            public T FindMin()
            {
                if (minNode == null)
                    throw new InvalidOperationException("Heap is empty");
                return minNode.Key;
            }

            public T ExtractMin()
            {
                if (minNode == null)
                    throw new InvalidOperationException("Heap is empty");

                var min = minNode;
                if (min.Child != null)
                {
                    var child = min.Child;
                    do
                    {
                        var next = child.Right;
                        AddToRootList(child);
                        child.Parent = null;
                        child = next;
                    } while (child != min.Child);
                }

                RemoveFromRootList(min);
                if (min == min.Right)
                {
                    minNode = null;
                }
                else
                {
                    minNode = min.Right;
                    Consolidate();
                }
                count--;
                return min.Key;
            }

            private void AddToRootList(Node node)
            {
                node.Left = minNode;
                node.Right = minNode.Right;
                minNode.Right.Left = node;
                minNode.Right = node;
            }

            private void RemoveFromRootList(Node node)
            {
                node.Left.Right = node.Right;
                node.Right.Left = node.Left;
            }

            private void Consolidate()
            {
                var degreeTable = new Dictionary<int, Node>();
                var nodes = new List<Node>();
                var current = minNode;
                do
                {
                    nodes.Add(current);
                    current = current.Right;
                } while (current != minNode);

                foreach (var node in nodes)
                {
                    var x = node;
                    var deg = x.Degree;
                    while (degreeTable.ContainsKey(deg))
                    {
                        var y = degreeTable[deg];
                        if (x.Key.CompareTo(y.Key) > 0)
                        {
                            var temp = x;
                            x = y;
                            y = temp;
                        }
                        Link(y, x);
                        degreeTable.Remove(deg);
                        deg++;
                    }
                    degreeTable[deg] = x;
                }

                minNode = null;
                foreach (var node in degreeTable.Values)
                {
                    if (minNode == null)
                    {
                        minNode = node;
                    }
                    else
                    {
                        AddToRootList(node);
                        if (node.Key.CompareTo(minNode.Key) < 0)
                            minNode = node;
                    }
                }
            }

            private void Link(Node child, Node parent)
            {
                RemoveFromRootList(child);
                child.Left = child.Right = child;
                if (parent.Child == null)
                {
                    parent.Child = child;
                }
                else
                {
                    AddToChildList(parent.Child, child);
                }
                child.Parent = parent;
                parent.Degree++;
                child.Marked = false;
            }

            private void AddToChildList(Node parent, Node child)
            {
                child.Left = parent;
                child.Right = parent.Right;
                parent.Right.Left = child;
                parent.Right = child;
            }

            public int Count => count;
            public bool IsEmpty => minNode == null;
        }
        #endregion

        #region 1.8 Max Flow - Ford-Fulkerson
        public static class FordFulkerson
        {
            public static int MaxFlow(int[,] capacity, int source, int sink)
            {
                int n = capacity.GetLength(0);
                int[,] residual = (int[,])capacity.Clone();
                int[] parent = new int[n];
                int maxFlow = 0;

                while (BFS(residual, source, sink, parent))
                {
                    int pathFlow = int.MaxValue;
                    for (int v = sink; v != source; v = parent[v])
                    {
                        int u = parent[v];
                        pathFlow = Math.Min(pathFlow, residual[u, v]);
                    }

                    for (int v = sink; v != source; v = parent[v])
                    {
                        int u = parent[v];
                        residual[u, v] -= pathFlow;
                        residual[v, u] += pathFlow;
                    }

                    maxFlow += pathFlow;
                }

                return maxFlow;
            }

            private static bool BFS(int[,] residual, int source, int sink, int[] parent)
            {
                int n = residual.GetLength(0);
                bool[] visited = new bool[n];
                Queue<int> queue = new Queue<int>();

                queue.Enqueue(source);
                visited[source] = true;
                parent[source] = -1;

                while (queue.Count > 0)
                {
                    int u = queue.Dequeue();

                    for (int v = 0; v < n; v++)
                    {
                        if (!visited[v] && residual[u, v] > 0)
                        {
                            queue.Enqueue(v);
                            parent[v] = u;
                            visited[v] = true;
                            if (v == sink)
                                return true;
                        }
                    }
                }

                return false;
            }
        }
        #endregion

        #region 1.9 Поиск мостов
        public static class BridgeFinder
        {
            public struct Bridge
            {
                public int u;
                public int v;
            }

            public static List<Bridge> FindBridges(int n, List<List<int>> graph)
            {
                int[] disc = new int[n];
                int[] low = new int[n];
                int[] parent = new int[n];
                bool[] visited = new bool[n];
                List<Bridge> bridges = new List<Bridge>();
                int time = 0;

                InitializeArray(disc, -1);
                InitializeArray(parent, -1);

                for (int i = 0; i < n; i++)
                {
                    if (!visited[i])
                    {
                        DFS(i, disc, low, parent, visited, graph, bridges, ref time);
                    }
                }

                return bridges;
            }

            private static void InitializeArray(int[] array, int value)
            {
                for (int i = 0; i < array.Length; i++)
                {
                    array[i] = value;
                }
            }

            private static void DFS(int u, int[] disc, int[] low, int[] parent, bool[] visited,
                List<List<int>> graph, List<Bridge> bridges, ref int time)
            {
                visited[u] = true;
                disc[u] = low[u] = ++time;

                foreach (int v in graph[u])
                {
                    if (!visited[v])
                    {
                        parent[v] = u;
                        DFS(v, disc, low, parent, visited, graph, bridges, ref time);

                        low[u] = Math.Min(low[u], low[v]);

                        if (low[v] > disc[u])
                        {
                            bridges.Add(new Bridge { u = u, v = v });
                        }
                    }
                    else if (v != parent[u])
                    {
                        low[u] = Math.Min(low[u], disc[v]);
                    }
                }
            }
        }
