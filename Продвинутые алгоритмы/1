        #region 1.17 KMP
        public static class KMP
        {
            public static List<int> Search(string text, string pattern)
            {
                List<int> matches = new List<int>();
                if (string.IsNullOrEmpty(pattern)) return matches;

                int[] lps = ComputeLPS(pattern);
                int i = 0, j = 0;

                while (i < text.Length)
                {
                    if (text[i] == pattern[j])
                    {
                        i++;
                        j++;
                    }

                    if (j == pattern.Length)
                    {
                        matches.Add(i - j);
                        j = lps[j - 1];
                    }
                    else if (i < text.Length && text[i] != pattern[j])
                    {
                        if (j != 0)
                            j = lps[j - 1];
                        else
                            i++;
                    }
                }

                return matches;
            }

            private static int[] ComputeLPS(string pattern)
            {
                int[] lps = new int[pattern.Length];
                int len = 0;
                int i = 1;

                while (i < pattern.Length)
                {
                    if (pattern[i] == pattern[len])
                    {
                        len++;
                        lps[i] = len;
                        i++;
                    }
                    else
                    {
                        if (len != 0)
                        {
                            len = lps[len - 1];
                        }
                        else
                        {
                            lps[i] = 0;
                            i++;
                        }
                    }
                }

                return lps;
            }
        }
        #endregion

        #region 1.18 Rabin-Karp
        public static class RabinKarp
        {
            private const int prime = 101;
            private const int mod = 1000000007;

            public static List<int> Search(string text, string pattern)
            {
                List<int> matches = new List<int>();
                int n = text.Length;
                int m = pattern.Length;
                if (n < m) return matches;

                long patternHash = CreateHash(pattern, m);
                long textHash = CreateHash(text, m);

                for (int i = 0; i <= n - m; i++)
                {
                    if (patternHash == textHash && CheckEqual(text, i, i + m - 1, pattern))
                    {
                        matches.Add(i);
                    }

                    if (i < n - m)
                    {
                        textHash = RecalculateHash(text, i, i + m, textHash, m);
                    }
                }

                return matches;
            }

            private static long CreateHash(string str, int length)
            {
                long hash = 0;
                for (int i = 0; i < length; i++)
                {
                    hash = (hash * prime + str[i]) % mod;
                }
                return hash;
            }

            private static long RecalculateHash(string str, int oldIndex, int newIndex, long oldHash, int patternLen)
            {
                long newHash = (oldHash - str[oldIndex] * Pow(prime, patternLen - 1)) % mod;
                newHash = (newHash * prime + str[newIndex]) % mod;
                return newHash < 0 ? newHash + mod : newHash;
            }

            private static long Pow(long baseValue, int exponent)
            {
                long result = 1;
                for (int i = 0; i < exponent; i++)
                {
                    result = (result * baseValue) % mod;
                }
                return result;
            }

            private static bool CheckEqual(string text, int start, int end, string pattern)
            {
                if (end - start + 1 != pattern.Length) return false;
                for (int i = 0; i < pattern.Length; i++)
                {
                    if (text[start + i] != pattern[i]) return false;
                }
                return true;
            }
        }
        #endregion

        #region 1.19 Внешняя сортировка
        public static class ExternalSorter
        {
            public static void SortFile(string inputFile, string outputFile, int chunkSize)
            {
                // Разделение на отсортированные чанки
                List<string> chunkFiles = new List<string>();
                using (var reader = new StreamReader(inputFile))
                {
                    List<int> chunk = new List<int>();
                    string line;
                    int chunkCount = 0;

                    while ((line = reader.ReadLine()) != null)
                    {
                        if (int.TryParse(line, out int number))
                        {
                            chunk.Add(number);
                            if (chunk.Count >= chunkSize)
                            {
                                chunk.Sort();
                                string chunkFile = $"chunk_{chunkCount++}.txt";
                                File.WriteAllLines(chunkFile, chunk.Select(x => x.ToString()));
                                chunkFiles.Add(chunkFile);
                                chunk.Clear();
                            }
                        }
                    }

                    if (chunk.Count > 0)
                    {
                        chunk.Sort();
                        string chunkFile = $"chunk_{chunkCount++}.txt";
                        File.WriteAllLines(chunkFile, chunk.Select(x => x.ToString()));
                        chunkFiles.Add(chunkFile);
                    }
                }

                // Многофазное слияние
                MergeChunks(chunkFiles, outputFile);

                // Очистка временных файлов
                foreach (string chunkFile in chunkFiles)
                {
                    if (File.Exists(chunkFile))
                        File.Delete(chunkFile);
                }
            }

            private static void MergeChunks(List<string> chunkFiles, string outputFile)
            {
                var readers = chunkFiles.Select(f => new StreamReader(f)).ToArray();
                var heap = new PriorityQueue<(int value, int readerIndex), int>();

                // Инициализация кучи
                for (int i = 0; i < readers.Length; i++)
                {
                    string line = readers[i].ReadLine();
                    if (line != null && int.TryParse(line, out int value))
                    {
                        heap.Enqueue((value, i), value);
                    }
                }

                using (var writer = new StreamWriter(outputFile))
                {
                    while (heap.Count > 0)
                    {
                        var (value, readerIndex) = heap.Dequeue();
                        writer.WriteLine(value);

                        string line = readers[readerIndex].ReadLine();
                        if (line != null && int.TryParse(line, out int nextValue))
                        {
                            heap.Enqueue((nextValue, readerIndex), nextValue);
                        }
                    }
                }

                foreach (var reader in readers)
                {
                    reader.Close();
                }
            }
        }
        #endregion

        #region 1.20 Median Finder
        public class MedianFinder
        {
            private PriorityQueue<int, int> maxHeap;
            private PriorityQueue<int, int> minHeap;

            public MedianFinder()
            {
                maxHeap = new PriorityQueue<int, int>();
                minHeap = new PriorityQueue<int, int>();
            }

            public void AddNum(int num)
            {
                if (maxHeap.Count == 0 || num <= GetMaxHeapPeek())
                {
                    maxHeap.Enqueue(num, -num);
                }
                else
                {
                    minHeap.Enqueue(num, num);
                }

                if (maxHeap.Count > minHeap.Count + 1)
                {
                    var moved = maxHeap.Dequeue();
                    minHeap.Enqueue(moved, moved);
                }
                else if (minHeap.Count > maxHeap.Count)
                {
                    var moved = minHeap.Dequeue();
                    maxHeap.Enqueue(moved, -moved);
                }
            }

            public double FindMedian()
            {
                if (maxHeap.Count == minHeap.Count)
                {
                    return (GetMaxHeapPeek() + minHeap.Peek()) / 2.0;
                }
                else
                {
                    return GetMaxHeapPeek();
                }
            }

            private int GetMaxHeapPeek()
            {
                return maxHeap.Peek();
            }
        }
        #endregion
