        #region 1.12 Алгоритм Крускала
        public static class Kruskal
        {
            public struct Edge
            {
                public int from;
                public int to;
                public int weight;

                public Edge(int from, int to, int weight)
                {
                    this.from = from;
                    this.to = to;
                    this.weight = weight;
                }
            }

            public static (int cost, List<Edge> edges) FindMST(int n, List<Edge> edges)
            {
                edges.Sort((a, b) => a.weight.CompareTo(b.weight));
                var uf = new UnionFind(n);
                List<Edge> mst = new List<Edge>();
                int cost = 0;

                foreach (var edge in edges)
                {
                    if (uf.Union(edge.from, edge.to))
                    {
                        mst.Add(edge);
                        cost += edge.weight;
                        if (mst.Count == n - 1)
                            break;
                    }
                }

                return (cost, mst);
            }
        }
