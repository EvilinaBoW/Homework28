        #region 1.11 LCA
        public class LCA
        {
            private int n;
            private int logn;
            private List<List<int>> tree;
            private int[] depth;
            private int[,] parent;

            public LCA(List<List<int>> tree, int root)
            {
                this.tree = tree;
                n = tree.Count;
                logn = (int)Math.Ceiling(Math.Log(n, 2)) + 1;
                depth = new int[n];
                parent = new int[n, logn];

                for (int i = 0; i < n; i++)
                    for (int j = 0; j < logn; j++)
                        parent[i, j] = -1;

                DFS(root, -1, 0);

                for (int j = 1; j < logn; j++)
                    for (int i = 0; i < n; i++)
                        if (parent[i, j - 1] != -1)
                            parent[i, j] = parent[parent[i, j - 1], j - 1];
            }

            private void DFS(int u, int p, int d)
            {
                depth[u] = d;
                parent[u, 0] = p;

                foreach (int v in tree[u])
                {
                    if (v != p)
                        DFS(v, u, d + 1);
                }
            }

            public int FindLCA(int u, int v)
            {
                if (depth[u] < depth[v])
                {
                    int temp = u;
                    u = v;
                    v = temp;
                }

                int diff = depth[u] - depth[v];
                for (int i = 0; i < logn; i++)
                    if ((diff & (1 << i)) != 0)
                        u = parent[u, i];

                if (u == v) return u;

                for (int i = logn - 1; i >= 0; i--)
                {
                    if (parent[u, i] != -1 && parent[u, i] != parent[v, i])
                    {
                        u = parent[u, i];
                        v = parent[v, i];
                    }
                }

                return parent[u, 0];
            }
        }
