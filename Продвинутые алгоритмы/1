                int[] low = new int[n];
                int[] parent = new int[n];
                bool[] visited = new bool[n];
                bool[] ap = new bool[n];
                int time = 0;

                InitializeArray(disc, -1);
                InitializeArray(parent, -1);

                for (int i = 0; i < n; i++)
                {
                    if (!visited[i])
                    {
                        DFS(i, disc, low, parent, visited, ap, graph, ref time);
                    }
                }

                List<int> result = new List<int>();
                for (int i = 0; i < n; i++)
                {
                    if (ap[i])
                        result.Add(i);
                }

                return result;
            }

            private static void InitializeArray(int[] array, int value)
            {
